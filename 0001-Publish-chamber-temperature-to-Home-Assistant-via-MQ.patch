 src/xtouch/config.h          |  14 ++++
 src/xtouch/sensors/chamber.h |   2 +
 src/xtouch/sensors/ha_mqtt.h | 135 +++++++++++++++++++++++++++++++++++
 src/xtouch/types.h           |   5 ++
 5 files changed, 158 insertions(+)
 create mode 100644 src/xtouch/sensors/ha_mqtt.h

